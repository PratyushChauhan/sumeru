<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Login item registered via SMAppService.agent: starts Sumeru hidden in the menu bar. -->
<dict>
  <key>Label</key><string>com.sumeru.app.login</string>
  <key>BundleProgram</key><string>Contents/MacOS/Sumeru</string>
  <key>ProgramArguments</key><array><string>Contents/MacOS/Sumeru</string><string>--hidden</string></array>
  <key>RunAtLoad</key><true/>
  <key>AssociatedBundleIdentifiers</key><array><string>com.sumeru.app</string></array>
</dict>
</plist>
